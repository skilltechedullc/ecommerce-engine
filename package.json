{
  "name": "ecommerce-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:phase3": "node --import tsx --test tests/checkout-hardening.test.ts",
    "test:security": "node --import tsx --test tests/security-hardening.test.ts",
    "test:audit": "node --import tsx --test tests/audit-reliability.test.ts",
    "test:config": "node --import tsx --test tests/config-separation.test.ts",
    "test:phase7": "node --import tsx --test tests/phase7-validation.test.ts",
    "test:catalog": "node --import tsx --test tests/catalog-tools.test.ts",
    "test:orders": "node --import tsx --test tests/order-tracking.test.ts",
    "test:roadmap": "node --import tsx --test tests/roadmap-docs.test.ts",
    "client:env": "node scripts/create-client-env-template.mjs",
    "client:setup": "node scripts/create-client-setup.mjs",
    "client:handover": "node scripts/generate-client-handover.mjs",
    "client:preview": "node scripts/preview-client-store.mjs",
    "supabase:plan": "node scripts/plan-supabase-migration.mjs",
    "supabase:apply": "node scripts/apply-supabase-migrations.mjs",
    "storage:verify": "node scripts/verify-storage-setup.mjs",
    "storage:cleanup-products": "node scripts/cleanup-product-images.mjs",
    "readiness": "node scripts/check-production-readiness.mjs",
    "catalog:validate-import": "node scripts/validate-product-import.mjs",
    "catalog:seed-millco": "node scripts/seed-millco-sample-catalog.mjs",
