# ============================================================
# Payments
# ============================================================
# Razorpay key ID used on the server.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Razorpay key ID exposed to the client for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Razorpay key secret used for order creation and verification.
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Razorpay webhook secret configured in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

