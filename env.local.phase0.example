# Safe local Phase 0 environment template.
# Copy this to .env.local only when you intentionally want to run against local/test services.
# Do not put production Supabase, payment, email, WhatsApp, or AI secrets here.

NODE_ENV=development

# Local app URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_SITE_URL=http://localhost:3000

# Supabase local defaults from `supabase start` are usually printed by the CLI.
# Replace these placeholders with the local values after Supabase local is running.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-start

# Admin local-only credentials
ADMIN_PASSWORD=change-this-local-admin-password
ADMIN_SESSION_SECRET=change-this-local-session-secret
ADMIN_EMAIL=admin@example.test
ADMIN_AUTH_MODE=single_password

# Razorpay test mode only
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me

# Email disabled/safe by default
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=orders@example.test

# AI disabled by default
ANTHROPIC_API_KEY=

# Production distributed rate limiting is not used locally
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp disabled by default
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=local_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_FROM=
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PROCESSING=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WATI_API_BASE_URL=
WATI_API_TOKEN=
GUPSHUP_API_BASE_URL=
GUPSHUP_APP_NAME=
GUPSHUP_API_KEY=

# Manual shipping only for local hardening
SHIPPING_PROVIDER=manual
SHIPPING_AUTO_CREATE=false
NEXT_PUBLIC_SHIPPING_FLAT_RATE=0
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=0
NEXT_PUBLIC_SHIPPING_RATE_RULES_JSON=[]
SHIPPING_PICKUP_NAME=Local Store
SHIPPING_PICKUP_PHONE=0000000000
SHIPPING_PICKUP_ADDRESS_LINE1=Local pickup address
SHIPPING_PICKUP_ADDRESS_LINE2=
SHIPPING_PICKUP_CITY=Local City
SHIPPING_PICKUP_STATE=Local State
SHIPPING_PICKUP_PINCODE=000000
SHIPPING_PICKUP_COUNTRY=India

# Brand/demo defaults
NEXT_PUBLIC_STORE_PRESET=generic
NEXT_PUBLIC_BRAND_NAME=Local Demo Store
NEXT_PUBLIC_BRAND_SHORT_NAME=Demo
NEXT_PUBLIC_BRAND_DESCRIPTION=Local ecommerce engine demo store.
NEXT_PUBLIC_LOGO_URL=/millco-logo.svg
NEXT_PUBLIC_THEME_PRESET=natural
NEXT_PUBLIC_CONTACT_EMAIL=support@example.test
NEXT_PUBLIC_CONTACT_PHONE=0000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ADDRESS_LINE_1=Local address line 1
NEXT_PUBLIC_ADDRESS_LINE_2=
NEXT_PUBLIC_ADDRESS_CITY=Local City
NEXT_PUBLIC_ADDRESS_STATE=Local State
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=000000
NEXT_PUBLIC_ADDRESS_COUNTRY=India
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Local Demo Store
NEXT_PUBLIC_LEGAL_WEBSITE_LABEL=localhost:3000
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=support@example.test
NEXT_PUBLIC_LEGAL_BUSINESS_DESCRIPTION=the sale of demo products in a local test store
NEXT_PUBLIC_LEGAL_JURISDICTION_COUNTRY=India

NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=INR
NEXT_PUBLIC_LOCALE=en_IN
NEXT_PUBLIC_NUMBER_LOCALE=en-IN
NEXT_PUBLIC_COUNTRY_CODE=IN
NEXT_PUBLIC_COUNTRY_NAME=India
NEXT_PUBLIC_SHIPPING_COVERAGE_LABEL=Local test area

NEXT_PUBLIC_FEATURE_WHATSAPP_BOT=false
NEXT_PUBLIC_FEATURE_AI_CHAT=false
NEXT_PUBLIC_FEATURE_INSTAGRAM_SYNC=false
NEXT_PUBLIC_FEATURE_LOYALTY_POINTS=false
NEXT_PUBLIC_FEATURE_ABANDONED_CART_RECOVERY=false
NEXT_PUBLIC_FEATURE_PRODUCT_REVIEWS=false
NEXT_PUBLIC_FEATURE_ADVANCED_ANALYTICS=false
NEXT_PUBLIC_FEATURE_MULTI_LANGUAGE=false
NEXT_PUBLIC_FEATURE_MULTI_CURRENCY=false
NEXT_PUBLIC_FEATURE_SHIPPING_INTEGRATIONS=false
NEXT_PUBLIC_FEATURE_MANUAL_PAYMENTS=false
