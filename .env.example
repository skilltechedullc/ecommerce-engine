# Public browser anon key for the tenant's Supabase project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side service role key for privileged writes and admin APIs.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ============================================================
# Admin
# ============================================================
# Password used by the built-in admin login screen.
